{
  "key": "confluence-agentic-chat-bot",
  "name": "Intelligent Confluence Assistant",
  "description": "A contextual chat agent powered by dynamic CQL synthesis.",
  "vendor": {
    "name": "Christian Pfister",
    "url": "https://o6ventures.com"
  },
  "baseUrl": "https://api.o6-confluence-chat.de",
  "authentication": {
    "type": "none"
  },
  "scopes": [
    "read",
    "act_as_user"
  ],
  "modules": {
    "webPanels": [
      {
        "key": "chat-bottom-panel",
        "url": "/index.html?pageId={page.id}&spaceKey={space.key}",
        "location": "atl.general",
        "name": {
          "value": "Ask AI Agent"
        },
        "layout": {
          "width": "100%",
          "height": "400px"
        }
      }
    ],
    "webItems": [
      {
        "key": "chatbot-launcher-action",
        "location": "system.content.action",
        "url": "/index.html?pageId={page.id}&spaceKey={space.key}",
        "name": {
          "value": "Ask AI (Popup)"
        },
        "target": {
          "type": "dialog",
          "key": "chat-dialog-fallback"
        }
      }
    ],
    "dialogs": [
      {
        "key": "chat-dialog-fallback",
        "url": "/index.html?pageId={page.id}&spaceKey={space.key}",
        "title": {
          "value": "AI Chat Assistant"
        },
        "options": {
          "width": "400px",
          "height": "100%",
          "chrome": false
        }
      }
    ]
  }
}
