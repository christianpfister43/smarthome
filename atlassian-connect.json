{
  "key": "confluence-agentic-chat-bot",
  "name": "Intelligent Confluence Assistant",
  "description": "A contextual chat agent powered by dynamic CQL synthesis.",
  "vendor": {
    "name": "Christian Pfister",
    "url": "https://o6ventures.com"
  },
  "baseUrl": "https://api.o6-confluence-chat.de",
  "authentication": {
    "type": "jwt"
  },
  "lifecycle": {
    "installed": "/installed",
    "uninstalled": "/uninstalled"
  },
  "scopes": [
    "read",
    "act_as_user"
  ],
  "modules": {
    "webItems": [
      {
        "key": "chat-trigger-button",
        "location": "system.header/left",
        "weight": 100,
        "name": {
          "value": "Ask AI Agent"
        },
        "target": {
          "type": "dialog",
          "options": {
            "height": "100%",
            "width": "400px",
            "chrome": false
          }
        },
        "url": "/chat-interface?pageId={page.id}&spaceKey={space.key}"
      }
    ]
  }
}
